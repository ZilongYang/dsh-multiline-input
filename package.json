{
  "name": "dsh-multiline-input",
  "version": "0.2.0",
  "type": "module",
  "description": "Single/multi-line composer toggle for DeepSeek Harness: a collapsible hint tab, an editable Cmd/Ctrl+E shortcut, submitted-text history with arrow-key recall, a 4-line floor for multi-line drafts, and Shift+Enter to send.",
  "license": "MIT",
  "author": "ZilongYang",
  "icon": "./icon.svg",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "composer",
    "multiline",
    "input",
    "keyboard-shortcut",
    "web"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/zh.json",
    "locale/en.json",
    "screenshots.json",
    "assets",
    "README.md",
    "ROADMAP.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.5 <0.3.0-0"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZilongYang/dsh-multiline-input.git"
  },
  "homepage": "https://dsh.zlmix.com/multiline-input/",
  "bugs": {
    "url": "https://github.com/ZilongYang/dsh-multiline-input/issues"
  }
}
